{
    "name": "@adernnell/vectorio",
    "description": "A lightweight 3D math library for TypeScript games and graphics, inspired by gl-matrix.",
    "author": "Quentin Allender",
    "keywords": [
        "gl-matrix",
        "vector",
        "matrix",
        "quaternion",
        "webgl",
        "typescript",
        "math",
        "graphics"
    ],
    "license": "MIT",
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./vec2": {
            "types": "./dist/vec2/aliases.d.ts",
            "default": "./dist/vec2/aliases.js"
        },
        "./vec3": {
            "types": "./dist/vec3/aliases.d.ts",
            "default": "./dist/vec3/aliases.js"
        },
        "./vec4": {
            "types": "./dist/vec4/aliases.d.ts",
            "default": "./dist/vec4/aliases.js"
        },
        "./mat2": {
            "types": "./dist/mat2/aliases.d.ts",
            "default": "./dist/mat2/aliases.js"
        },
        "./mat3": {
            "types": "./dist/mat3/aliases.d.ts",
            "default": "./dist/mat3/aliases.js"
        },
        "./mat4": {
            "types": "./dist/mat4/aliases.d.ts",
            "default": "./dist/mat4/aliases.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b ./tsconfig.build.json --force && vite build",
        "test": "vitest",
        "coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "typescript": "^6.0.2",
        "vite": "^6.1.0",
        "@vitest/coverage-v8": "^3.2.4",
        "vitest": "^3.0.8"
    }
}
